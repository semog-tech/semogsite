{
  "name": "semog-home-v2",
  "version": "0.0.0",
  "private": true,
  "description": "Nova home da Semog. Página estática montada a partir de parciais; abre por file://.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "dev": "node build.mjs && node serve.mjs",
    "capturar": "node build.mjs && node scripts/capturar.mjs",
    "format": "prettier --write \"src/**/*.{js,css,html,json}\" \"scripts/*.mjs\" \"*.{mjs,json,md}\""
  },
  "dependencies": {
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "three": "0.186.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "1.60.0",
    "prettier": "3.9.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
